#!/bin/sh
# The ps2sdk gcc from the ps2dev Docker image, as the linker for TinyGo's
# ps2 target (targets/ps2.json names this command). Everything the link
# reads is mounted at its host path inside the container: the temp directory
# (TinyGo's objects), the current directory, the SDK copy ($PS2DEV) and the
# TinyGo tree ($TINYGOROOT, for targets/ps2.ld), so the paths in the
# command line need no translation. With a native ps2dev toolchain on PATH
# this wrapper is not needed.
# A native toolchain elsewhere on PATH (the tinygo-ps2 image, a ps2dev
# install) is used directly.
self=$(cd "$(dirname "$0")" && pwd)
IFS=:
for dir in $PATH; do
	[ "$dir" = "$self" ] && continue
	[ -x "$dir/mips64r5900el-ps2-elf-gcc" ] && exec "$dir/mips64r5900el-ps2-elf-gcc" "$@"
done
unset IFS

mounts="-v /tmp:/tmp -v $PWD:$PWD"
for dir in "$HOME" "$PS2DEV" "$TINYGOROOT"; do
	[ -n "$dir" ] && [ -d "$dir" ] && mounts="$mounts -v $dir:$dir"
done
# shellcheck disable=SC2086
exec docker run --rm --user="$(id -u):$(id -g)" $mounts -w "$PWD" \
	"${PS2DEV_IMAGE:-ps2dev/ps2dev:v2.0.0}" mips64r5900el-ps2-elf-gcc "$@"
